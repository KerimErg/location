# ─── Base de données PostgreSQL (Neon) ───────────────────────────────────────
# Connexion POOLÉE (hôte contenant "-pooler") : utilisée par l'application.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require"
# Connexion DIRECTE (même URL sans "-pooler") : utilisée par les migrations Prisma.
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.eu-central-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# ─── Authentification (NextAuth) ─────────────────────────────────────────────
# Générez une valeur : openssl rand -base64 32
NEXTAUTH_SECRET="change-me"
# URL publique du site (http://localhost:3000 en local, https://votre-projet.vercel.app en prod)
NEXTAUTH_URL="http://localhost:3000"

# ─── Stripe (non utilisé pour l'instant) ─────────────────────────────────────
# Le paiement est simulé dans cette version. À renseigner le jour où Stripe est branché :
# STRIPE_SECRET_KEY="sk_live_..."
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_live_..."
# STRIPE_WEBHOOK_SECRET="whsec_..."
