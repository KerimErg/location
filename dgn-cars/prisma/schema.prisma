// DGN Cars — PostgreSQL (Neon en production).
// DATABASE_URL : connexion poolée (site) · DIRECT_URL : connexion directe (migrations).
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Fuel {
  ESSENCE
  DIESEL
  HYBRIDE
  HYBRIDE_RECHARGEABLE
  ELECTRIQUE
}

enum Gearbox {
  MANUELLE
  AUTOMATIQUE
}

enum Body {
  CITADINE
  COMPACTE
  BERLINE
  BREAK
  SUV
  COUPE
  CABRIOLET
  MONOSPACE
}

enum VehicleStatus {
  DISPONIBLE
  RESERVE
  VENDU
}

enum LeadType {
  ESSAI
  REPRISE
  FINANCEMENT
  CONTACT
}

enum LeadStatus {
  NOUVEAU
  EN_COURS
  TRAITE
  ARCHIVE
}

model Admin {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  createdAt    DateTime @default(now())
}

model Vehicle {
  id                String        @id @default(cuid())
  slug              String        @unique
  reference         String        @unique // n° de stock interne, ex. DGN-2411
  make              String
  model             String
  version           String
  firstRegistration DateTime
  mileage           Int
  price             Int // euros TVAC
  previousPrice     Int?
  vatDeductible     Boolean       @default(false)
  fuel              Fuel
  gearbox           Gearbox
  body              Body
  powerKw           Int
  engineCc          Int?
  euroNorm          String
  co2               Int?
  doors             Int
  seats             Int
  color             String
  owners            Int           @default(1)
  carPass           Boolean       @default(true)
  warrantyMonths    Int           @default(12)
  options           String[]
  description       String
  images            String[]
  status            VehicleStatus @default(DISPONIBLE)
  featured          Boolean       @default(false)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  leads             Lead[]

  @@index([status, make])
}

model Lead {
  id            String     @id @default(cuid())
  type          LeadType
  status        LeadStatus @default(NOUVEAU)
  name          String
  email         String
  phone         String
  message       String?
  preferredDate DateTime?
  vehicleId     String?
  vehicle       Vehicle?   @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  details       Json?
  createdAt     DateTime   @default(now())

  @@index([status, createdAt])
}
